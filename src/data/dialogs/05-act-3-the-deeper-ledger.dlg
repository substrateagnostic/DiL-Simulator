  set isaiah_skeptic_noticed
  goto n0
  # 116–118: Diane notices Apprentice energy

  @n116
  Diane: You're being kind to yourself today. I noticed. It's in how you're walking — less braced.
  Diane: Keep doing that. It's data. People who are kind to themselves make better decisions under pressure. That's not philosophy — that's in the literature.
  set diane_apprentice_noticed
  goto n0
